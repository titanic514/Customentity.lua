local function GetCurrentRoom()
    if not CurrentRooms then
        return nil
    end

    local latest
    local latestNumber = -math.huge

    for _, room in ipairs(CurrentRooms:GetChildren()) do
        local number = tonumber(room.Name)

        if number and number > latestNumber then
            latestNumber = number
            latest = room
        end
    end

    return latest
end

local function GetRoomAtPoint(position)
    if not CurrentRooms then
        return nil
    end

    for _, room in ipairs(CurrentRooms:GetChildren()) do
        local entrance = room:FindFirstChild("RoomEntrance")
        local exit = room:FindFirstChild("RoomExit")

        if entrance and exit then
            local minX = math.min(
                entrance.Position.X,
                exit.Position.X
            )

            local maxX = math.max(
                entrance.Position.X,
                exit.Position.X
            )

            local minZ = math.min(
                entrance.Position.Z,
                exit.Position.Z
            )

            local maxZ = math.max(
                entrance.Position.Z,
                exit.Position.Z
            )

            if position.X >= minX
                and position.X <= maxX
                and position.Z >= minZ
                and position.Z <= maxZ then

                return room
            end
        end
    end

    return nil
end

local function FixRoomLights(room)
    if not room then
        return
    end

    if not room:IsDescendantOf(workspace) then
        return
    end

    for _, obj in ipairs(room:GetDescendants()) do
        if obj:IsA("Light") then
            pcall(function()
                obj.Enabled = true
            end)
        end
    end
end

