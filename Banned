local function GetNodesFromRoom(room)
    local result = {}

    if not room then
        return result
    end

    local nodes = room:FindFirstChild("PathfindNodes")

    if not nodes then
        return result
    end

    for _, node in ipairs(nodes:GetChildren()) do
        if node:IsA("BasePart") then
            table.insert(result, node)
        end
    end

    table.sort(result, function(a, b)
        return a.Name < b.Name
    end)

    return result
end

local function GetPathfindNodesAmbush(config)
    local currentRoom = GetCurrentRoom()

    if not currentRoom then
        return {}
    end

    return GetNodesFromRoom(currentRoom)
end

local function GetPathfindNodesBlitz(config)
    local currentRoom = GetCurrentRoom()

    if not currentRoom then
        return {}, {}
    end

    local nodes = GetNodesFromRoom(currentRoom)

    return nodes, nodes
end

-- ============================================================
-- Movement
-- ============================================================

local function EntityMoveTo(entity, position, speed)
    if not entity
        or not entity.Model
        or not entity.Model.PrimaryPart then

        return false
    end

    local root = entity.Model.PrimaryPart

    local distance = (root.Position - position).Magnitude

    if distance <= 0.05 then
        return true
    end

    speed = tonumber(speed) or CONST.BASE_ENTITY_SPEED

    local duration = distance / math.max(speed, 0.01)

    local tween = TweenService:Create(
        root,
        TweenInfo.new(
            duration,
            Enum.EasingStyle.Linear
        ),
        {
            CFrame = CFrame.new(position)
                * root.CFrame.Rotation
        }
    )

    tween:Play()

    while tween.PlaybackState == Enum.PlaybackState.Playing do
        if not entity:IsAlive() then
            tween:Cancel()
            return false
        end

        if entity.Config.Paused then
            tween:Pause()

            repeat
                RunService.Heartbeat:Wait()
            until not entity.Config.Paused
                or not entity:IsAlive()

            if not entity:IsAlive() then
                tween:Cancel()
                return false
            end

            tween:Play()
        end

        RunService.Heartbeat:Wait()
    end

    return true
end

-- ============================================================
-- Camera Shake / Earthquake
-- ============================================================

local function Earthquake(config)
    if not config.Earthquake.Enabled then
        return
    end

    if not Camera then
        return
    end

    local start = tick()

    task.spawn(function()
        while tick() - start < 1 do
            if not Camera then
                break
            end

            local x = (math.random() - 0.5) * 0.12
            local y = (math.random() - 0.5) * 0.12
            local z = (math.random() - 0.5) * 0.12

            Camera.CFrame =
                Camera.CFrame
                * CFrame.new(x, y, z)

            RunService.RenderStepped:Wait()
        end
    end)
end

local function CameraShake(config, distance)
    if not config.CameraShake.Enabled then
        return
    end

    local range = tonumber(config.CameraShake.Range) or 100

    if distance > range then
        return
    end

    if not Camera then
        return
    end

    local values = config.CameraShake.Values

    local intensity = tonumber(values[1]) or 1.5
    local duration = tonumber(values[4]) or 1

    local multiplier = 1 - math.clamp(distance / range, 0, 1)

    task.spawn(function()
        local start = tick()

        while tick() - start < duration do
            local strength =
                intensity
                * multiplier
                * 0.03

            Camera.CFrame =
                Camera.CFrame
                * CFrame.new(
                    (math.random() - 0.5) * strength,
                    (math.random() - 0.5) * strength,
                    (math.random() - 0.5) * strength
                )

            RunService.RenderStepped:Wait()
        end
    end)
end

-- ============================================================
-- Spawner Module
-- ============================================================

local Module = {
    ActiveEntities = {},
    Connections = {}
}

-- ============================================================
-- Create
-- ============================================================

function Module.Create(config)
    local newConfig = ApplyConfigDefaults(
        CloneTable(config or {})
    )

    -- --------------------------------------------------------
    -- Entity Source
    -- --------------------------------------------------------

    local source = newConfig.Entity.Source

    local entityModel = ResolveEntityModel(source)

    if not entityModel then
        warn(
            "[VynixuEntitySpawnerV2] Entity.Source did not return an Instance."
        )

        return nil
    end

    -- Convert BasePart into Model automatically.
    if entityModel:IsA("BasePart") then
        local model = Instance.new("Model")
        model.Name = newConfig.Entity.Name

        entityModel.Parent = model
        model.PrimaryPart = entityModel

        entityModel = model
    end

    if not entityModel:IsA("Model") then
        warn(
            "[VynixuEntitySpawnerV2] Entity.Source must return a Model or BasePart."
        )

        return nil
    end

    -- --------------------------------------------------------
    -- PrimaryPart fallback
    -- --------------------------------------------------------

    if not entityModel.PrimaryPart then
        local root =
            entityModel:FindFirstChild("HumanoidRootPart", true)

        if root and root:IsA("BasePart") then
            entityModel.PrimaryPart = root
        else
            for _, obj in ipairs(entityModel:GetDescendants()) do
                if obj:IsA("BasePart") then
                    entityModel.PrimaryPart = obj
                    break
                end
            end
        end
    end

    if not entityModel.PrimaryPart then
        warn(
            "[VynixuEntitySpawnerV2] Entity model has no BasePart to use as PrimaryPart."
        )

        return nil
    end

    -- --------------------------------------------------------
    -- Prepare Model
    -- --------------------------------------------------------

    entityModel.Name = newConfig.Entity.Name

    for name, value in next, CONST.ATTR.ENTITY do
        pcall(function()
            entityModel:SetAttribute(name, value)
        end)
    end

    local roomsEntered = Instance.new("Folder")
    roomsEntered.Name = "RoomsEntered"
    roomsEntered.Parent = entityModel

    local entity = {
        Model = entityModel,
        Config = newConfig,
        Debug = newConfig.DEBUG,
        _alive = true
    }

    -- --------------------------------------------------------
    -- API
    -- --------------------------------------------------------

    function entity:SetCallback(name, callback)
        if type(name) ~= "string" then
            return self
        end

        self.Debug[name] = callback

        return self
    end

    function entity:RunCallback(name, ...)
        SafeCall(
            self.Debug[name],
            self,
            ...
        )
    end

    function entity:IsAlive()
        return self._alive
            and self.Model ~= nil
            and self.Model.Parent ~= nil
    end

    function entity:Pause()
        self.Config.Paused = true

        pcall(function()
            self.Model:SetAttribute("Paused", true)
        end)

        return self
    end

    function entity:Resume()
        self.Config.Paused = false

        pcall(function()
            self.Model:SetAttribute("Paused", false)
        end)

        return self
    end

    function entity:Despawn()
        if not self._alive then
            return
        end

        self._alive = false

        pcall(function()
            self.Model:SetAttribute("Despawning", true)
        end)

        self:RunCallback("OnDespawned")

        local index = table.find(Module.ActiveEntities, self)

        if index then
            table.remove(Module.ActiveEntities, index)
        end

        if self.Model then
            pcall(function()
                self.Model:Destroy()
            end)
        end
    end

    function entity:Run(copyEntity)
        return Module.Run(self, copyEntity)
    end

    return entity
end

-- ============================================================
-- Run
-- ============================================================

function Module.Run(entity, copyEntity)
    if not entity or not entity:IsAlive() then
        return
    end

    local config = entity.Config
    local model = entity.Model

    -- --------------------------------------------------------
    -- Attributes
    -- --------------------------------------------------------

    model:SetAttribute("Running", true)
    model:SetAttribute("CustomEntity", true)
    model:SetAttribute("Paused", false)
    model:SetAttribute("BeingBanished", false)
    model:SetAttribute("Despawning", false)
    model:SetAttribute("Damage", config.Damage.Enabled)
    model:SetAttribute("LastEnteredRoom", -1)

    table.insert(Module.ActiveEntities, entity)

    -- --------------------------------------------------------
    -- Spawn location
    -- --------------------------------------------------------

    local currentRoom = GetCurrentRoom()

    if not currentRoom then
        entity:Despawn()
        return
    end

    local spawnPart

    if config.Movement.Reversed then
        spawnPart = currentRoom:FindFirstChild("RoomExit")
    else
        spawnPart = currentRoom:FindFirstChild("RoomEntrance")
    end

    if not spawnPart or not spawnPart:IsA("BasePart") then
        spawnPart = currentRoom:FindFirstChildWhichIsA(
            "BasePart",
            true
        )
    end

    if not spawnPart then
        entity:Despawn()
        return
    end

    -- --------------------------------------------------------
    -- Spawn
    -- --------------------------------------------------------

    local spawnCFrame =
        spawnPart.CFrame
        + Vector3.new(
            0,
            config.Entity.HeightOffset,
            0
        )

    model:PivotTo(spawnCFrame)
    model.Parent = workspace

    entity:RunCallback(
        "OnSpawned"
    )

    -- --------------------------------------------------------
    -- Initial effects
    -- --------------------------------------------------------

    Earthquake(config)

    task.wait(
        tonumber(config.Movement.Delay) or 0
    )

    if not entity:IsAlive() then
        return
    end

    entity:RunCallback("OnStartMoving")

    -- --------------------------------------------------------
    -- Detection loop
    -- --------------------------------------------------------

    local detectionConnection

    detectionConnection = RunService.Heartbeat:Connect(function()
        if not entity:IsAlive() then
            if detectionConnection then
                detectionConnection:Disconnect()
            end

            return
        end

        if entity.Config.Paused then
            return
        end

        if not RootPart then
            return
        end

        local entityRoot = model.PrimaryPart

        if not entityRoot then
            return
        end

        local origin = entityRoot.Position
        local playerPosition = RootPart.Position

        local distance =
            (origin - playerPosition).Magnitude

        -- ----------------------------------------------------
        -- Line of sight
        -- ----------------------------------------------------

        local inSight = false

        local rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.FilterDescendantsInstances = {
            Character,
            model
        }

        local direction =
            playerPosition - origin

        local ray = workspace:Raycast(
            origin,
            direction,
            rayParams
        )

        if not ray then
            inSight = true
        elseif Character
            and ray.Instance
            and ray.Instance:IsDescendantOf(Character) then

            inSight = true
        end

        -- ----------------------------------------------------
        -- Look detection
        -- ----------------------------------------------------

        if inSight and Camera then
            local cameraDirection =
                Camera.CFrame.LookVector

            local toEntity =
                (origin - Camera.CFrame.Position).Unit

            local dot =
                cameraDirection:Dot(toEntity)

            if dot > 0.85 then
                entity:RunCallback(
                    "OnLookAt"
                )
            end
        end

        -- ----------------------------------------------------
        -- Room detection
        -- ----------------------------------------------------

        local room = GetRoomAtPoint(origin)

        if room then
            local roomNumber = tonumber(room.Name)

            if roomNumber
                and roomNumber ~= entity.Config.LastEnteredRoom then

                entity.Config.LastEnteredRoom = roomNumber

                model:SetAttribute(
                    "LastEnteredRoom",
                    roomNumber
                )

                local marker = Instance.new("BoolValue")
                marker.Name = tostring(roomNumber)
                marker.Parent = model:FindFirstChild(
                    "RoomsEntered"
                )

                entity:RunCallback(
                    "OnEnterRoom",
                    room
                )

                -- Optional light repair.
                if config.Lights.Repair then
                    FixRoomLights(room)
                end
            end
        end

        -- ----------------------------------------------------
        -- Crucifix
        -- ----------------------------------------------------

        if config.Crucifixion.Enabled
            and distance <= config.Crucifixion.Range
            and inSight
            and not config.BeingBanished then

            local crucifix =
                HasEquipped("Crucifix")

            if crucifix then
                local overwritten = false

                if type(
                    config.DEBUG.CrucifixionOverwrite
                ) == "function" then

                    local success, result = pcall(
                        config.DEBUG.CrucifixionOverwrite,
                        entity,
                        crucifix
                    )

                    if success and result == true then
                        overwritten = true
                    end
                end

                if not overwritten then
                    CrucifixEntity(
                        entity,
                        config,
                        crucifix
                    )
                end

                return
            end
        end

        -- ----------------------------------------------------
        -- Damage
        -- ----------------------------------------------------

        if config.Damage.Enabled
            and distance <= config.Damage.Range
            and inSight
            and not entity.Config.BeingBanished
            and not IsPlayerProtected()
            and Humanoid
            and Humanoid.Health > 0 then

            local shouldDamage = true

            -- Try hiding detection.
            if not config.Damage.IgnoreHiding then
                pcall(function()
                    local hiding =
                        LocalPlayer:GetAttribute("Hiding")

                    if hiding == true then
                        shouldDamage = false
                    end
                end)

                if Character then
                    local hidden =
                        Character:GetAttribute("Hiding")

                    if hidden == true then
                        shouldDamage = false
                    end
                end
            end

            if shouldDamage
                and model:GetAttribute("Damage") ~= false then

                model:SetAttribute(
                    "Damage",
                    false
                )

                DamagePlayer(
                    config,
                    entity
                )
            end
        end

        -- ----------------------------------------------------
        -- Camera shake
        -- ----------------------------------------------------

        if distance <= config.CameraShake.Range then
            CameraShake(
                config,
                distance
            )
        end
    end)

    -- --------------------------------------------------------
    -- Movement task
    -- --------------------------------------------------------

    task.spawn(function()
        local speed =
            tonumber(config.Movement.Speed) or 100

        -- Normalize relative to original Vynixu speed.
        speed =
            speed / CONST.BASE_ENTITY_SPEED
            * CONST.BASE_ENTITY_SPEED

        -- ----------------------------------------------------
        -- Ambush
        -- ----------------------------------------------------

        if config.Rebounding.Enabled
            and string.lower(
                tostring(config.Rebounding.Type)
            ) == "ambush" then

            local nodes =
                GetPathfindNodesAmbush(config)

            local minRebounds =
                tonumber(config.Rebounding.Min) or 2

            local maxRebounds =
                tonumber(config.Rebounding.Max) or 4

            local rebounds =
                math.random(
                    minRebounds,
                    math.max(minRebounds, maxRebounds)
                )

            for rebound = 1, rebounds do
                if not entity:IsAlive() then
                    return
                end

                entity:RunCallback(
                    "OnRebounding",
                    rebound,
                    rebounds
                )

                -- Forward
                for _, node in ipairs(nodes) do
                    if not entity:IsAlive() then
                        return
                    end

                    EntityMoveTo(
                        entity,
                        node.Position,
                        speed
                    )

                    entity:RunCallback(
                        "OnReachedNode",
                        node
                    )
                end

                task.wait(
                    tonumber(config.Rebounding.Delay) or 2
                )

                -- Reverse
                for index = #nodes, 1, -1 do
                    if not entity:IsAlive() then
                        return
                    end

                    local node = nodes[index]

                    EntityMoveTo(
                        entity,
                        node.Position,
                        speed
                    )

                    entity:RunCallback(
                        "OnReachedNode",
                        node
                    )
                end

                task.wait(
                    tonumber(config.Rebounding.Delay) or 2
                )
            end

        -- ----------------------------------------------------
        -- Blitz
        -- ----------------------------------------------------

        elseif config.Rebounding.Enabled
            and string.lower(
                tostring(config.Rebounding.Type)
            ) == "blitz" then

            local nodesCurrent, nodesEnd =
                GetPathfindNodesBlitz(config)

            for _, node in ipairs(nodesCurrent) do
                if not entity:IsAlive() then
                    return
                end

                EntityMoveTo(
                    entity,
                    node.Position,
                    speed
                )

                entity:RunCallback(
                    "OnReachedNode",
                    node
                )
            end

            local minRebounds =
                tonumber(config.Rebounding.Min) or 2

            local maxRebounds =
                tonumber(config.Rebounding.Max) or 4

            local rebounds =
                math.random(
                    minRebounds,
                    math.max(minRebounds, maxRebounds)
                )

            for rebound = 1, rebounds do
                if not entity:IsAlive() then
                    return
                end

                entity:RunCallback(
                    "OnRebounding",
                    rebound,
                    rebounds
                )

                task.wait(
                    tonumber(config.Rebounding.Delay) or 2
                )

                for index = #nodesEnd, 1, -1 do
                    if not entity:IsAlive() then
                        return
                    end

                    EntityMoveTo(
                        entity,
                        nodesEnd[index].Position,
                        speed
                    )

                    entity:RunCallback(
                        "OnReachedNode",
                        nodesEnd[index]
                    )
                end
            end

        -- ----------------------------------------------------
        -- Normal entity
        -- ----------------------------------------------------

        else
            local nodes =
                GetNodesFromRoom(
                    GetCurrentRoom()
                )

            if config.Movement.Reversed then
                for index = #nodes, 1, -1 do
                    if not entity:IsAlive() then
                        return
                    end

                    local node = nodes[index]

                    EntityMoveTo(
                        entity,
                        node.Position,
                        speed
                    )

                    entity:RunCallback(
                        "OnReachedNode",
                        node
                    )
                end
            else
                for _, node in ipairs(nodes) do
                    if not entity:IsAlive() then
                        return
                    end

                    EntityMoveTo(
                        entity,
                        node.Position,
                        speed
                    )

                    entity:RunCallback(
                        "OnReachedNode",
                        node
                    )
                end
            end
        end

        -- ----------------------------------------------------
        -- Despawn
        -- ----------------------------------------------------

        if not entity:IsAlive() then
            return
        end

        model:SetAttribute(
            "Despawning",
            true
        )

        entity:RunCallback(
            "OnDespawning"
        )

        if model.PrimaryPart then
            EntityMoveTo(
                entity,
                model.PrimaryPart.Position
                    + Vector3.new(0, -300, 0),
                speed
            )
        end

        entity:Despawn()
    end)

    return entity
end

-- ============================================================
-- Clear
-- ============================================================

function Module.Clear()
    local entities = CloneTable(Module.ActiveEntities)

    for _, entity in ipairs(entities) do
        pcall(function()
            entity:Despawn()
        end)
    end

    table.clear(Module.ActiveEntities)
end

-- ============================================================
-- Unload
-- ============================================================

function Module.Unload()
    Module.Clear()

    for _, connection in ipairs(Module.Connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(Module.Connections)

    if getgenv().VynixuEntitySpawnerV2 == Module then
        getgenv().VynixuEntitySpawnerV2 = nil
    end
end

-- ============================================================
-- Player setup
-- ============================================================

for name, value in next, CONST.ATTR.PLAYER do
    LocalPlayer:SetAttribute(
        name,
        value
    )
end

LastRespawn =
    tick()
    - (LocalPlayer:GetAttribute("SpawnProtection") or 5)

table.insert(
    Module.Connections,
    LocalPlayer.CharacterAdded:Connect(function(character)
        LastRespawn = tick()
        OnCharacterAdded(character)
    end)
)

-- ============================================================
-- Workspace integration
-- ============================================================

if CurrentRooms then
    table.insert(
        Module.Connections,
        CurrentRooms.ChildAdded:Connect(function(room)
            task.defer(function()
                if room and room:IsA("Model") then
                    -- Give DOORS time to finish generating the room.
                    task.wait()

                    if config and false then
                        -- intentionally unused
                    end
                end
            end)
        end)
    )
end

-- ============================================================
-- Export
-- ============================================================

getgenv().VynixuEntitySpawnerV2 = Module

return Module
