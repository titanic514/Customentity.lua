-- ============================================================
-- Utility
-- ============================================================

local function CloneTable(tbl)
    if type(tbl) ~= "table" then
        return tbl
    end

    local clone = {}

    for key, value in next, tbl do
        if type(value) == "table" then
            clone[key] = CloneTable(value)
        else
            clone[key] = value
        end
    end

    return clone
end

local function SafeCall(callback, ...)
    if type(callback) ~= "function" then
        return
    end

    local args = table.pack(...)

    task.spawn(function()
        pcall(function()
            callback(table.unpack(args, 1, args.n))
        end)
    end)
end

-- ============================================================
-- Source Entity Loader
-- ============================================================

local function ExecuteSource(source)
    if type(source) ~= "string" or source == "" then
        return nil
    end

    local code = source

    -- URL source
    if source:match("^https?://") then
        local success, result = pcall(function()
            return game:HttpGet(source)
        end)

        if not success then
            warn("[EntitySpawner] Failed to download entity source:", result)
            return nil
        end

        code = result
    end

    local compileSuccess, chunk = pcall(function()
        return loadstring(code, "VynixuEntitySource")
    end)

    if not compileSuccess or type(chunk) ~= "function" then
        warn("[EntitySpawner] Failed to compile entity source:", chunk)
        return nil
    end

    local executeSuccess, result = xpcall(
        chunk,
        function(err)
            return debug.traceback(tostring(err), 2)
        end
    )

    if not executeSuccess then
        warn("[EntitySpawner] Entity source error:\n" .. tostring(result))
        return nil
    end

    return result
end

local function ResolveEntityModel(source)
    if typeof(source) == "Instance" then
        return source
    end

    if type(source) ~= "string" then
        return nil
    end

    local result = ExecuteSource(source)

    if typeof(result) == "Instance" then
        return result
    end

    if type(result) == "table" then
        local model =
            result.Model
            or result.Entity
            or result.Instance

        if typeof(model) == "Instance" then
            return model
        end
    end

    return nil
end

