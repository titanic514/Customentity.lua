local function GetDeathCause(config)
    if config.Death.Cause
        and config.Death.Cause ~= "" then

        return config.Death.Cause
    end

    return config.Entity.Name
end

local function ShowDeathHints(config)
    local hints = config.Death.Hints

    if type(hints) ~= "table" then
        return
    end

    -- Try DOORS' normal death hint system.
    local deathHint = nil

    pcall(function()
        local mainUI = PlayerGui:FindFirstChild("MainUI")

        if mainUI then
            deathHint = mainUI:FindFirstChild("Death")
                or mainUI:FindFirstChild("DeathHint")
        end
    end)

    -- Use Module_Events when available.
    local moduleEvents

    pcall(function()
        local modulesClient =
            ReplicatedStorage:FindFirstChild("ModulesClient")

        if modulesClient then
            local moduleScript =
                modulesClient:FindFirstChild("Module_Events")

            if moduleScript then
                moduleEvents = require(moduleScript)
            end
        end
    end)

    if moduleEvents then
        local functions = {
            "death",
            "Death",
            "deathHint",
            "DeathHint"
        }

        for _, functionName in ipairs(functions) do
            local fn = moduleEvents[functionName]

            if type(fn) == "function" then
                local success = pcall(function()
                    fn(
                        GetDeathCause(config),
                        hints,
                        config.Death.Type
                    )
                end)

                if success then
                    return
                end
            end
        end
    end

    -- Fallback: display the hints through a temporary ScreenGui.
    local gui = Instance.new("ScreenGui")
    gui.Name = "VynixuEntityDeathHints"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.Parent = PlayerGui

    local frame = Instance.new("Frame")
    frame.AnchorPoint = Vector2.new(0.5, 0.5)
    frame.Position = UDim2.fromScale(0.5, 0.5)
    frame.Size = UDim2.fromScale(0.7, 0.3)
    frame.BackgroundTransparency = 1
    frame.Parent = gui

    local text = Instance.new("TextLabel")
    text.BackgroundTransparency = 1
    text.Size = UDim2.fromScale(1, 1)
    text.TextScaled = true
    text.Font = Enum.Font.Gotham
    text.Text = table.concat(hints, "\n")
    text.TextTransparency = 1
    text.Parent = frame

    local fadeIn = TweenService:Create(
        text,
        TweenInfo.new(0.35),
        {TextTransparency = 0}
    )

    local fadeOut = TweenService:Create(
        text,
        TweenInfo.new(0.5),
        {TextTransparency = 1}
    )

    fadeIn:Play()

    task.delay(3, function()
        fadeOut:Play()

        fadeOut.Completed:Connect(function()
            if gui then
                gui:Destroy()
            end
        end)
    end)
end

local function DamagePlayer(config, entity)
    if not Humanoid or Humanoid.Health <= 0 then
        return
    end

    if IsPlayerProtected() then
        return
    end

    SafeCall(
        config.DEBUG.OnDamagePlayer,
        entity
    )

    local amount = tonumber(config.Damage.Amount) or 125

    pcall(function()
        Humanoid:TakeDamage(amount)
    end)

    if Humanoid.Health <= 0 then
        task.spawn(function()
            ShowDeathHints(config)
        end)
    end
end

-- ============================================================
-- Crucifix
-- ============================================================

local function CrucifixEntity(entity, config, tool)
    if not entity or not entity.Model then
        return false
    end

    if entity.Config.BeingBanished then
        return true
    end

    entity.Config.BeingBanished = true

    SafeCall(
        config.DEBUG.CrucifixionOverwrite,
        entity,
        tool
    )

    local model = entity.Model

    -- Stop damage immediately.
    model:SetAttribute("Damage", false)

    -- Try to freeze the entity.
    pcall(function()
        if model.PrimaryPart then
            model.PrimaryPart.Anchored = true
        end
    end)

    -- Disable visible parts gradually.
    for _, obj in ipairs(model:GetDescendants()) do
        if obj:IsA("BasePart") then
            pcall(function()
                TweenService:Create(
                    obj,
                    TweenInfo.new(1),
                    {
                        Transparency = 1
                    }
                ):Play()
            end)
        elseif obj:IsA("ParticleEmitter")
            or obj:IsA("Beam")
            or obj:IsA("Trail") then

            pcall(function()
                obj.Enabled = false
            end)
        end
    end

    if tool and tool.Parent then
        pcall(function()
            tool:Destroy()
        end)
    end

    task.delay(1.1, function()
        if entity and entity.IsAlive and entity:IsAlive() then
            entity:Despawn()
        end
    end)

    return true
end

