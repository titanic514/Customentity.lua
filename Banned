local function ApplyConfigDefaults(config)
    config = config or {}

    local function Merge(target, defaults)
        for key, defaultValue in next, defaults do
            if target[key] == nil then
                if type(defaultValue) == "table" then
                    target[key] = CloneTable(defaultValue)
                else
                    target[key] = defaultValue
                end
            elseif type(defaultValue) == "table" and type(target[key]) == "table" then
                Merge(target[key], defaultValue)
            end
        end
    end

    Merge(config, CONST.DEFAULT)

    -- Allow old configs that used Entity.Asset to still fail
    -- cleanly instead of trying to load an Asset ID.
    config.Entity.Asset = nil

    return config
end

