--[[
    Source.lua
    Roblox XML / RBXMX -> Model loader

    API:

        local Source = loadstring(...)
        local model = Source.execute(source, "MyModel")

    or:

        local model = Source:execute(source, "MyModel")

    Optional external references:

        Source:AddReferent("SomeName", instance)

    IMPORTANT:
        This module does NOT download anything.
        This module does NOT require an asset ID.
        This module does NOT contain a model.
        This module does NOT require a model URL.

        The caller supplies the source text.
]]

local Source = {}

----------------------------------------------------------------
-- STATE
----------------------------------------------------------------

local settings = {
    ConserveMemory = true,
    AutoParent = true
}

local referents = {
    DataModel = game,
    game = game,
    Workspace = workspace,
    workspace = workspace
}

local sharedStrings = {}

----------------------------------------------------------------
-- HELPERS
----------------------------------------------------------------

local function splitWords(value)
    local result = {}

    for word in tostring(value):gmatch("%S+") do
        result[#result + 1] = word
    end

    return result
end

local function number(value, default)
    value = tonumber(value)

    if value == nil then
        return default or 0
    end

    return value
end

local function boolean(value)
    return tostring(value):lower() == "true"
end

local function clampInt32(value)
    return math.clamp(
        math.round(number(value)),
        -2147483648,
        2147483647
    )
end

local function clampInt64(value)
    return math.clamp(
        math.round(number(value)),
        -4503599627370497,
        4503599627370496
    )
end

----------------------------------------------------------------
-- BASE64
----------------------------------------------------------------

local BASE64_ALPHABET =
    "ABCDEFGHIJKLMNOPQRSTUVWXYZ" ..
    "abcdefghijklmnopqrstuvwxyz" ..
    "0123456789+/"

local BASE64_LOOKUP = {}

for i = 1, #BASE64_ALPHABET do
    BASE64_LOOKUP[BASE64_ALPHABET:sub(i, i)] = i - 1
end

local function base64Decode(input)
    input = tostring(input)
    input = input:gsub("[^%w%+/=]", "")

    local output = {}

    local i = 1

    while i <= #input do
        local a = BASE64_LOOKUP[input:sub(i, i)] or 0
        local b = BASE64_LOOKUP[input:sub(i + 1, i + 1)] or 0
        local c = BASE64_LOOKUP[input:sub(i + 2, i + 2)] or 0
        local d = BASE64_LOOKUP[input:sub(i + 3, i + 3)] or 0

        local n =
            a * 262144 +
            b * 4096 +
            c * 64 +
            d

        local x = math.floor(n / 65536) % 256
        local y = math.floor(n / 256) % 256
        local z = n % 256

        output[#output + 1] = string.char(x)

        if input:sub(i + 2, i + 2) ~= "=" then
            output[#output + 1] = string.char(y)
        end

        if input:sub(i + 3, i + 3) ~= "=" then
            output[#output + 1] = string.char(z)
        end

        i += 4
    end

    return table.concat(output)
end

----------------------------------------------------------------
-- HEX
----------------------------------------------------------------

local function hexDecode(value)
    value = tostring(value)

    return (
        value:gsub("%x%x", function(pair)
            return string.char(tonumber(pair, 16))
        end)
    )
end

----------------------------------------------------------------
-- XML ATTRIBUTE PARSER
----------------------------------------------------------------

local function parseAttributes(text)
    local attributes = {}

    for key, quote, value in tostring(text):gmatch(
        "([%w:_%-]+)%s*=%s*([\"'])(.-)%2"
    ) do
        attributes[key] = value
    end

    return attributes
end

----------------------------------------------------------------
-- XML PARSER
----------------------------------------------------------------

local function parseXML(source)
    assert(
        type(source) == "string",
        "Source.execute: Source must be a string"
    )

    local root = {
        Type = nil,
        Text = nil,
        Attributes = {},
        Contents = {},
        Parent = nil
    }

    local stack = { root }
    local position = 1

    while true do
        local startPos,
            endPos,
            closing,
            tagName,
            attributeText,
            selfClosing =
            source:find(
                "<(/?)([%w:_%-]+)(.-)(/?)>",
                position
            )

        if not startPos then
            break
        end

        local text = source:sub(
            position,
            startPos - 1
        )

        local cdata = text:match(
            "<!%[CDATA%[(.-)%]%]>"
        )

        if cdata then
            stack[#stack].Text = cdata
        else
            local cleanText = text:match("^%s*(.-)%s*$")

            if cleanText ~= "" then
                stack[#stack].Text = cleanText
            end
        end

        if selfClosing == "/" then

            local node = {
                Type = tagName,
                Text = nil,
                Attributes = parseAttributes(attributeText),
                Contents = {},
                selfCloses = true,
                Parent = stack[#stack]
            }

            table.insert(
                stack[#stack].Contents,
                node
            )

        elseif closing == "" then

            local node = {
                Type = tagName,
                Text = nil,
                Attributes = parseAttributes(attributeText),
                Contents = {},
                Parent = stack[#stack]
            }

            table.insert(
                stack[#stack].Contents,
                node
            )

            table.insert(stack, node)

        else

            assert(
                #stack > 1,
                "Unexpected closing tag </"
                    .. tagName
                    .. ">"
            )

            local node = table.remove(stack)

            assert(
                node.Type == tagName,
                "Expected </"
                    .. tostring(node.Type)
                    .. "> but received </"
                    .. tostring(tagName)
                    .. ">"
            )

        end

        position = endPos + 1
    end

    local remaining = source:sub(position)

    if remaining:match("%S") then
        stack[#stack].Text = remaining
    end

    assert(
        #stack == 1,
        "Unclosed XML tag: <"
            .. tostring(stack[#stack].Type)
            .. ">"
    )

    return root
end

----------------------------------------------------------------
-- CONTENT TYPES
----------------------------------------------------------------

local Types = {}

----------------------------------------------------------------
-- BASIC TYPES
----------------------------------------------------------------

Types.bool = function(tag, object)
    object[tag.Attributes.name] =
        boolean(tag.Text)
end

Types.string = function(tag, object)
    object[tag.Attributes.name] =
        tostring(tag.Text or "")
end

Types.ProtectedString = function(tag, object)
    object[tag.Attributes.name] =
        tostring(tag.Text or "")
end

Types.BinaryString = function(tag, object)
    object[tag.Attributes.name] =
        base64Decode(tag.Text or "")
end

Types.SharedString = function(tag, object)
    local key = base64Decode(tag.Text or "")

    object[tag.Attributes.name] =
        sharedStrings[key]
end

Types.UniqueId = function(tag, object)
    object[tag.Attributes.name] =
        hexDecode(tag.Text or "")
end

Types.float = function(tag, object)
    object[tag.Attributes.name] =
        number(tag.Text)
end

Types.double = function(tag, object)
    object[tag.Attributes.name] =
        number(tag.Text)
end

Types.int = function(tag, object)
    object[tag.Attributes.name] =
        clampInt32(tag.Text)
end

Types.int64 = function(tag, object)
    object[tag.Attributes.name] =
        clampInt64(tag.Text)
end

Types.token = function(tag, object)
    object[tag.Attributes.name] =
        math.round(number(tag.Text))
end

Types.BrickColor = function(tag, object)
    object[tag.Attributes.name] =
        math.round(number(tag.Text))
end

----------------------------------------------------------------
-- VECTOR TYPES
----------------------------------------------------------------

local function childMap(tag)
    local result = {}

    for _, child in ipairs(tag.Contents or {}) do
        if child.Type then
            result[child.Type] = child
        end
    end

    return result
end

Types.Vector3 = function(tag, object)
    local axes = childMap(tag)

    object[tag.Attributes.name] = Vector3.new(
        number(axes.X and axes.X.Text),
        number(axes.Y and axes.Y.Text),
        number(axes.Z and axes.Z.Text)
    )
end

Types.Vector2 = function(tag, object)
    local axes = childMap(tag)

    object[tag.Attributes.name] = Vector2.new(
        number(axes.X and axes.X.Text),
        number(axes.Y and axes.Y.Text)
    )
end

Types.Vector3int16 = function(tag, object)
    local axes = childMap(tag)

    object[tag.Attributes.name] =
        Vector3int16.new(
            math.round(number(axes.X and axes.X.Text)),
            math.round(number(axes.Y and axes.Y.Text)),
            math.round(number(axes.Z and axes.Z.Text))
        )
end

Types.Vector2int16 = function(tag, object)
    local axes = childMap(tag)

    object[tag.Attributes.name] =
        Vector2int16.new(
            math.round(number(axes.X and axes.X.Text)),
            math.round(number(axes.Y and axes.Y.Text))
        )
end

----------------------------------------------------------------
-- COLOR
----------------------------------------------------------------

Types.Color3 = function(tag, object)
    if tag.Text and tag.Text ~= "" then

        local value =
            tonumber(tag.Text) or 0

        object[tag.Attributes.name] =
            Color3.fromRGB(
                bit32.extract(value, 16, 8),
                bit32.extract(value, 8, 8),
                bit32.extract(value, 0, 8)
            )

        return
    end

    local colors = childMap(tag)

    object[tag.Attributes.name] =
        Color3.new(
            number(colors.R and colors.R.Text),
            number(colors.G and colors.G.Text),
            number(colors.B and colors.B.Text)
        )
end

Types.Color3uint8 = function(tag, object)
    local value =
        tonumber(tag.Text or 0)

    object[tag.Attributes.name] =
        Color3.fromRGB(
            bit32.extract(value, 16, 8),
            bit32.extract(value, 8, 8),
            bit32.extract(value, 0, 8)
        )
end

----------------------------------------------------------------
-- CFRAME
----------------------------------------------------------------

Types.CoordinateFrame = function(tag, object)
    local axes = childMap(tag)

    object[tag.Attributes.name] =
        CFrame.new(
            number(axes.X and axes.X.Text),
            number(axes.Y and axes.Y.Text),
            number(axes.Z and axes.Z.Text),

            number(axes.R00 and axes.R00.Text),
            number(axes.R01 and axes.R01.Text),
            number(axes.R02 and axes.R02.Text),

            number(axes.R10 and axes.R10.Text),
            number(axes.R11 and axes.R11.Text),
            number(axes.R12 and axes.R12.Text),

            number(axes.R20 and axes.R20.Text),
            number(axes.R21 and axes.R21.Text),
            number(axes.R22 and axes.R22.Text)
        )
end

Types.OptionalCoordinateFrame = function(tag, object)
    local child = tag.Contents
        and tag.Contents[1]

    if not child then
        object[tag.Attributes.name] =
            CFrame.identity
        return
    end

    if child.Type == "CFrame" then
        Types.CoordinateFrame(child, object)
    else
        object[tag.Attributes.name] =
            CFrame.identity
    end
end

