----------------------------------------------------------------
-- NUMBER RANGE
----------------------------------------------------------------

Types.NumberRange = function(tag, object)
    local values = splitWords(tag.Text or "")

    object[tag.Attributes.name] =
        NumberRange.new(
            number(values[1]),
            number(values[2], number(values[1]))
        )
end

----------------------------------------------------------------
-- NUMBER SEQUENCE
----------------------------------------------------------------

Types.NumberSequence = function(tag, object)
    local values = splitWords(tag.Text or "")
    local points = {}

    for i = 1, #values, 3 do
        if values[i + 2] then
            points[#points + 1] =
                NumberSequenceKeypoint.new(
                    number(values[i]),
                    number(values[i + 1]),
                    number(values[i + 2])
                )
        end
    end

    object[tag.Attributes.name] =
        NumberSequence.new(points)
end

----------------------------------------------------------------
-- COLOR SEQUENCE
----------------------------------------------------------------

Types.ColorSequence = function(tag, object)
    local values = splitWords(tag.Text or "")
    local points = {}

    for i = 1, #values, 4 do
        if values[i + 3] then
            points[#points + 1] =
                ColorSequenceKeypoint.new(
                    number(values[i]),
                    number(values[i + 1]),
                    number(values[i + 2])
                )
        end
    end

    object[tag.Attributes.name] =
        ColorSequence.new(points)
end

----------------------------------------------------------------
-- PHYSICAL PROPERTIES
----------------------------------------------------------------

Types.PhysicalProperties = function(tag, object)
    local values = childMap(tag)

    if values.CustomPhysics
        and boolean(values.CustomPhysics.Text)
    then

        object[tag.Attributes.name] =
            PhysicalProperties.new(
                number(values.Density and values.Density.Text),
                number(values.Friction and values.Friction.Text),
                number(values.Elasticity and values.Elasticity.Text),
                number(
                    values.FrictionWeight
                    and values.FrictionWeight.Text
                ),
                number(
                    values.ElasticityWeight
                    and values.ElasticityWeight.Text
                )
            )
    end
end

----------------------------------------------------------------
-- FACES
----------------------------------------------------------------

Types.Faces = function(tag, object)
    local values = childMap(tag)

    local mask =
        number(values.faces and values.faces.Text)

    object[tag.Attributes.name] =
        Faces.new(
            mask % 2 == 1,
            math.floor(mask / 2) % 2 == 1,
            math.floor(mask / 4) % 2 == 1,
            math.floor(mask / 8) % 2 == 1,
            math.floor(mask / 16) % 2 == 1,
            math.floor(mask / 32) % 2 == 1
        )
end

----------------------------------------------------------------
-- AXES
----------------------------------------------------------------

Types.Axes = function(tag, object)
    local values = childMap(tag)
    local mask = number(values.axes and values.axes.Text)

    object[tag.Attributes.name] =
        Axes.new(
            mask % 2 == 1,
            math.floor(mask / 2) % 2 == 1,
            math.floor(mask / 4) % 2 == 1
        )
end

----------------------------------------------------------------
-- REFERENCE
----------------------------------------------------------------

Types.Ref = function(tag, object)
    local name = tostring(tag.Text or "")
    local target = referents[name]

    if target then
        object[tag.Attributes.name] = target
        return
    end

    task.spawn(function()
        while true do
            local instance = referents[name]

            if instance then
                object[tag.Attributes.name] = instance
                break
            end

            task.wait()
        end
    end)
end

----------------------------------------------------------------
-- CONTENT
----------------------------------------------------------------

Types.Content = function(tag, object)
    local child = tag.Contents
        and tag.Contents[1]

    if not child then
        return
    end

    local handler = Types[child.Type]

    if handler then
        handler(child, object)
    end
end

----------------------------------------------------------------
-- SHARED STRINGS
----------------------------------------------------------------

Types.SharedStrings = function(tag)
    for _, child in ipairs(tag.Contents or {}) do
        if child.Type == "SharedString" then

            local key =
                base64Decode(
                    child.Attributes.md5 or ""
                )

            sharedStrings[key] =
                base64Decode(child.Text or "")
        end
    end
end

----------------------------------------------------------------
-- SETTINGS
----------------------------------------------------------------

Types.Settings = function(tag)
    for _, child in ipairs(tag.Contents or {}) do
        local handler = Types[child.Type]

        if handler then
            local temporary = {}

            handler(child, temporary)

            settings[
                child.Attributes.name
            ] = temporary[
                child.Attributes.name
            ]
        end
    end
end

----------------------------------------------------------------
-- ITEM
----------------------------------------------------------------

Types.Item = function(tag, parent)
    local className =
        tag.Attributes.class

    assert(
        type(className) == "string"
            and className ~= "",
        "Item is missing a class attribute"
    )

    local instance =
        Instance.new(className)

    tag.Instance = instance

    local referent =
        tag.Attributes.referent

    if referent then
        referents[referent] = instance

        if settings.ConserveMemory then
            pcall(function()
                instance.Destroying:Once(function()
                    referents[referent] = nil
                end)
            end)
        end
    end

    local properties

    for _, child in ipairs(tag.Contents or {}) do
        if child.Type == "Properties" then
            properties = child
            break
        end
    end

    if properties then
        for _, property in ipairs(
            properties.Contents or {}
        ) do

            local handler =
                Types[property.Type]

            if handler then
                pcall(
                    handler,
                    property,
                    instance
                )
            end
        end
    end

    if settings.AutoParent
        and not instance.Parent
        and not instance:IsA("Attachment")
    then
        instance.Parent = parent
    end

    return instance
end

----------------------------------------------------------------
-- RECURSIVE EXECUTION
----------------------------------------------------------------

local function executeTree(
    tag,
    model,
    first
)
    if first then
        local firstChild =
            tag.Contents
            and tag.Contents[1]

        assert(
            firstChild
                and firstChild.Type == "roblox",
            "Invalid source: expected <roblox> root"
        )
    end

    if tag.Type then
        local handler =
            Types[tag.Type]

        if handler then
            handler(tag, model)
        end
    end

    for _, child in ipairs(tag.Contents or {}) do
        if child.Type ~= "Properties" then
            executeTree(
                child,
                model,
                false
            )
        end
    end
end

----------------------------------------------------------------
-- PUBLIC API
----------------------------------------------------------------

function Source.execute(source, name)
    assert(
        type(source) == "string",
        "Source.execute(Source, Name): Source must be a string"
    )

    local model =
        Instance.new("Model")

    model.Name =
        tostring(
            name
            or "GeneratedModel"
        )

    local parsed =
        parseXML(source)

    executeTree(
        parsed,
        model,
        true
    )

    return model
end

function Source:AddReferent(name, instance)
    assert(
        typeof(instance) == "Instance",
        "AddReferent expected an Instance"
    )

    referents[
        tostring(name)
    ] = instance
end

function Source:SetSetting(name, value)
    if settings[name] ~= nil then
        settings[name] = value
    end
end

function Source:GetSetting(name)
    return settings[name]
end

return Source
